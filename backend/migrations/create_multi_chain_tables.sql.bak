File: supabase/migrations/create_multi_chain_tables.sql
-- Multi-Chain Wallet Infrastructure
-- Supports: Algorand + Bitcoin + Ethereum + TON + Lightning Network (via WDK)

-- ============================================================================
-- 1. MULTI-CHAIN ADDRESSES TABLE
-- ============================================================================
CREATE TABLE IF NOT EXISTS multi_chain_addresses (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    wallet_id TEXT,
    blockchain TEXT NOT NULL, -- 'algorand', 'ethereum', 'bitcoin', 'lightning', 'ton', 'polygon', 'arbitrum'
    address TEXT NOT NULL,
    encrypted_private_key TEXT, -- NULL for watch-only/imported wallets
    public_key TEXT,
    wallet_type TEXT DEFAULT 'managed', -- 'managed', 'imported', 'watch_only'
    is_imported BOOLEAN DEFAULT FALSE,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    
    UNIQUE(user_id, blockchain, address)
);

CREATE INDEX idx_multi_chain_user ON multi_chain_addresses(user_id);
CREATE INDEX idx_multi_chain_blockchain ON multi_chain_addresses(blockchain);
CREATE INDEX idx_multi_chain_address ON multi_chain_addresses(address);

-- Row Level Security
ALTER TABLE multi_chain_addresses ENABLE ROW LEVEL SECURITY;

CREATE POLICY multi_chain_addresses_policy ON multi_chain_addresses
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE multi_chain_addresses IS 'Stores wallet addresses across multiple blockchains for each user';

-- ============================================================================
-- 2. MULTI-CHAIN TRANSACTIONS TABLE
-- ============================================================================
CREATE TABLE IF NOT EXISTS multi_chain_transactions (
    id TEXT PRIMARY KEY,
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    blockchain TEXT NOT NULL,
    transaction_type TEXT NOT NULL, -- 'send', 'receive', 'swap', 'bridge'
    from_address TEXT,
    to_address TEXT,
    asset TEXT NOT NULL,
    amount DECIMAL(24, 8) NOT NULL,
    fee DECIMAL(24, 8),
    tx_hash TEXT,
    status TEXT DEFAULT 'pending', -- 'pending', 'confirmed', 'failed'
    confirmations INTEGER DEFAULT 0,
    block_number BIGINT,
    memo TEXT,
    metadata JSONB,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    confirmed_at TIMESTAMP
);

CREATE INDEX idx_multi_tx_user ON multi_chain_transactions(user_id);
CREATE INDEX idx_multi_tx_blockchain ON multi_chain_transactions(blockchain);
CREATE INDEX idx_multi_tx_hash ON multi_chain_transactions(tx_hash);
CREATE INDEX idx_multi_tx_status ON multi_chain_transactions(status);
CREATE INDEX idx_multi_tx_created ON multi_chain_transactions(created_at DESC);

-- Row Level Security
ALTER TABLE multi_chain_transactions ENABLE ROW LEVEL SECURITY;

CREATE POLICY multi_chain_transactions_policy ON multi_chain_transactions
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE multi_chain_transactions IS 'Unified transaction history across all supported blockchains';

-- ============================================================================
-- 3. BRIDGE TRANSACTIONS TABLE (Cross-Chain Transfers)
-- ============================================================================
CREATE TABLE IF NOT EXISTS bridge_transactions (
    id TEXT PRIMARY KEY,
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    asset TEXT NOT NULL,
    amount DECIMAL(24, 8) NOT NULL,
    fee DECIMAL(24, 8),
    from_chain TEXT NOT NULL,
    to_chain TEXT NOT NULL,
    from_address TEXT NOT NULL,
    to_address TEXT NOT NULL,
    status TEXT DEFAULT 'pending', -- 'pending', 'bridging', 'completed', 'failed'
    tx_hash_source TEXT, -- Transaction hash on source chain
    tx_hash_dest TEXT, -- Transaction hash on destination chain
    estimated_completion_time TEXT,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    completed_at TIMESTAMP,
    metadata JSONB
);

CREATE INDEX idx_bridge_user ON bridge_transactions(user_id);
CREATE INDEX idx_bridge_status ON bridge_transactions(status);
CREATE INDEX idx_bridge_created ON bridge_transactions(created_at DESC);

-- Row Level Security
ALTER TABLE bridge_transactions ENABLE ROW LEVEL SECURITY;

CREATE POLICY bridge_transactions_policy ON bridge_transactions
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE bridge_transactions IS 'Tracks cross-chain asset bridges (e.g., USDT from Ethereum to Polygon)';

-- ============================================================================
-- 4. LIGHTNING NETWORK INVOICES TABLE
-- ============================================================================
CREATE TABLE IF NOT EXISTS lightning_invoices (
    id TEXT PRIMARY KEY,
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    invoice_type TEXT NOT NULL, -- 'receive', 'send'
    payment_request TEXT NOT NULL,
    payment_hash TEXT,
    amount_sats BIGINT NOT NULL,
    amount_usd DECIMAL(18, 2),
    memo TEXT,
    status TEXT DEFAULT 'pending', -- 'pending', 'paid', 'expired', 'cancelled'
    expires_at TIMESTAMP NOT NULL,
    paid_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT NOW(),
    metadata JSONB
);

CREATE INDEX idx_lightning_user ON lightning_invoices(user_id);
CREATE INDEX idx_lightning_status ON lightning_invoices(status);
CREATE INDEX idx_lightning_hash ON lightning_invoices(payment_hash);

-- Row Level Security
ALTER TABLE lightning_invoices ENABLE ROW LEVEL SECURITY;

CREATE POLICY lightning_invoices_policy ON lightning_invoices
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE lightning_invoices IS 'Lightning Network payment invoices for instant Bitcoin micropayments';

-- ============================================================================
-- 5. ASSET SWAP HISTORY TABLE
-- ============================================================================
CREATE TABLE IF NOT EXISTS asset_swaps (
    id TEXT PRIMARY KEY,
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    blockchain TEXT NOT NULL,
    from_asset TEXT NOT NULL,
    to_asset TEXT NOT NULL,
    amount_in DECIMAL(24, 8) NOT NULL,
    amount_out DECIMAL(24, 8),
    exchange_rate DECIMAL(24, 8),
    fee DECIMAL(24, 8),
    slippage_percent DECIMAL(5, 2),
    dex_route JSONB, -- DEX routing info (hidden from user)
    tx_hash TEXT,
    status TEXT DEFAULT 'pending', -- 'pending', 'completed', 'failed'
    created_at TIMESTAMP DEFAULT NOW(),
    completed_at TIMESTAMP,
    metadata JSONB
);

CREATE INDEX idx_swaps_user ON asset_swaps(user_id);
CREATE INDEX idx_swaps_status ON asset_swaps(status);
CREATE INDEX idx_swaps_created ON asset_swaps(created_at DESC);

-- Row Level Security
ALTER TABLE asset_swaps ENABLE ROW LEVEL SECURITY;

CREATE POLICY asset_swaps_policy ON asset_swaps
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE asset_swaps IS 'Asset swap transactions across supported DEXes';

-- ============================================================================
-- 6. WALLET BALANCES CACHE (Performance Optimization)
-- ============================================================================
CREATE TABLE IF NOT EXISTS multi_chain_balances (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    blockchain TEXT NOT NULL,
    asset TEXT NOT NULL,
    balance DECIMAL(24, 8) DEFAULT 0,
    usd_value DECIMAL(18, 2) DEFAULT 0,
    last_updated TIMESTAMP DEFAULT NOW(),
    
    UNIQUE(user_id, blockchain, asset)
);

CREATE INDEX idx_balances_user ON multi_chain_balances(user_id);
CREATE INDEX idx_balances_blockchain ON multi_chain_balances(blockchain);

-- Row Level Security
ALTER TABLE multi_chain_balances ENABLE ROW LEVEL SECURITY;

CREATE POLICY multi_chain_balances_policy ON multi_chain_balances
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE multi_chain_balances IS 'Cached balances for performance (updated periodically)';

-- ============================================================================
-- 7. B2B API LICENSING TABLE (Enhanced)
-- ============================================================================
CREATE TABLE IF NOT EXISTS api_licenses (
    id TEXT PRIMARY KEY,
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    license_tier TEXT NOT NULL, -- 'builder', 'scale', 'enterprise'
    status TEXT DEFAULT 'active', -- 'active', 'suspended', 'expired'
    monthly_fee DECIMAL(18, 2) NOT NULL,
    api_call_limit BIGINT,
    volume_cap_usd DECIMAL(18, 2),
    transaction_fee_rate DECIMAL(5, 4) NOT NULL,
    chains_included JSONB, -- List of blockchain access
    api_key TEXT UNIQUE NOT NULL,
    api_secret TEXT NOT NULL,
    purchased_at TIMESTAMP DEFAULT NOW(),
    expires_at TIMESTAMP,
    last_payment_at TIMESTAMP,
    metadata JSONB
);

CREATE INDEX idx_api_licenses_user ON api_licenses(user_id);
CREATE INDEX idx_api_licenses_tier ON api_licenses(license_tier);
CREATE INDEX idx_api_licenses_key ON api_licenses(api_key);

-- Row Level Security
ALTER TABLE api_licenses ENABLE ROW LEVEL SECURITY;

CREATE POLICY api_licenses_policy ON api_licenses
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE api_licenses IS 'B2B API licensing for microfinance banks and fintechs ($3.5k-$15k/month)';

-- ============================================================================
-- 8. API USAGE TRACKING (For Billing)
-- ============================================================================
CREATE TABLE IF NOT EXISTS api_usage_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    license_id TEXT NOT NULL REFERENCES api_licenses(id) ON DELETE CASCADE,
    user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
    endpoint TEXT NOT NULL,
    method TEXT NOT NULL,
    blockchain TEXT,
    transaction_volume_usd DECIMAL(18, 2),
    response_status INTEGER,
    response_time_ms INTEGER,
    created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX idx_api_usage_license ON api_usage_logs(license_id);
CREATE INDEX idx_api_usage_date ON api_usage_logs(created_at DESC);

-- Row Level Security
ALTER TABLE api_usage_logs ENABLE ROW LEVEL SECURITY;

CREATE POLICY api_usage_logs_policy ON api_usage_logs
    FOR ALL USING (auth.uid() = user_id);

COMMENT ON TABLE api_usage_logs IS 'Track API usage for billing and analytics';

-- ============================================================================
-- 9. CHAIN STATUS MONITORING (Service Health)
-- ============================================================================
CREATE TABLE IF NOT EXISTS blockchain_status (
    blockchain TEXT PRIMARY KEY,
    is_operational BOOLEAN DEFAULT TRUE,
    last_block_number BIGINT,
    avg_confirmation_time_seconds INTEGER,
    current_gas_price TEXT,
    status_message TEXT,
    last_checked TIMESTAMP DEFAULT NOW()
);

-- Insert initial chains
INSERT INTO blockchain_status (blockchain, is_operational) VALUES
    ('algorand', TRUE),
    ('ethereum', TRUE),
    ('bitcoin', TRUE),
    ('lightning', TRUE),
    ('polygon', TRUE),
    ('arbitrum', TRUE),
