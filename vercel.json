{
  "version": 2,
  "builds": [
    { "src": "backend/api/main.py", "use": "@vercel/python" },
    { "src": "frontend/package.json", "use": "@vercel/static-build" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/api/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}